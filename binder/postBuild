#!/bin/bash
# repo2docker runs this after the environment is built.
#
# Voila hides execution errors by default (VoilaConfiguration.show_tracebacks is
# False), so a notebook that raises on Binder renders as a page with no widgets
# and no message at all - which looks identical to a broken widget frontend.
# Turn tracebacks on so any failure shows up in the rendered app, and give the
# kernel more room to start on a cold, memory-limited Binder container
# (VoilaExecutor.startup_timeout defaults to 60s).
set -euo pipefail

# Install the repo's own package so apps/ can `import bernina_prep`. Done here
# rather than as a "-e ." line in binder/environment.yml because pip resolves
# such a path against the working directory; this derives the repo root from
# the script's own location instead, so it does not depend on where
# repo2docker happens to run from. Dependencies come from environment.yml.
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
echo "postBuild: installing ${REPO_DIR} (bernina_prep) in editable mode"
pip install --no-deps -e "${REPO_DIR}"
python -c "import bernina_prep; print('bernina_prep import OK:', bernina_prep.__file__)"

mkdir -p "${HOME}/.jupyter"

read -r -d '' VOILA_CFG <<'JSON' || true
{
  "VoilaConfiguration": {
    "show_tracebacks": true
  },
  "VoilaExecutor": {
    "startup_timeout": 180
  }
}
JSON

# standalone voila (`voila notebook.ipynb`)
printf '%s\n' "$VOILA_CFG" > "${HOME}/.jupyter/voila.json"

# voila running as a jupyter-server extension, which is what Binder's
# ?urlpath=voila/render/... goes through
printf '%s\n' "$VOILA_CFG" > "${HOME}/.jupyter/jupyter_server_config.json"
