# The Python environment of the browser build (xeus-python on WebAssembly).
# build.sh fills in the wheels it builds or downloads: @WHEEL@ (bernina_prep),
# @HKLFORGE@ and @ESCAPE@. pip packages go in without their dependencies,
# so every dependency is listed here; escape-fel is only used for
# escape.bernina, which needs numpy, pandas and hklforge (not dask & co.).
#
# Compiled packages come from emscripten-forge, pure-Python ones from
# conda-forge (noarch) or PyPI. Space groups, CIF and structure factors are
# hklforge's own (hklforge.crystal; gemmi has no WebAssembly build).
name: xeus-python-kernel
channels:
  - https://repo.prefix.dev/emscripten-forge-4x
  - conda-forge
dependencies:
  - xeus-python
  - numpy
  - scipy
  - matplotlib
  - pandas
  - ipywidgets
  - ipympl
  - sqlalchemy       # xraydb
  - pyyaml           # hklforge
  - platformdirs     # xraydb
  - pip:
    - @HKLFORGE@
    - @ESCAPE@
    - xraydb
    - @WHEEL@
