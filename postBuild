#!/bin/bash
# repo2docker's CondaBuildPack starts every image from its own base
# environment, which already includes jupyterlab, notebook (a separate
# conda package -- it independently ships the @jupyter-notebook federated
# extension) and jupyter-resource-usage -- before environment.yml is even
# applied. `mamba env update` only adds/updates packages, it never removes
# ones already present, so simply omitting jupyterlab from environment.yml
# isn't enough: it's still in the final image, and its (and notebook's)
# federated extensions expect newer core JupyterLab module versions than
# the pinned voila (see environment.yml) bundles, breaking ipywidgets
# rendering under Voila with Module Federation "shared module ... doesn't
# exist" errors. Explicitly remove all three here, after the base+
# environment.yml install, so they're actually gone from the final image.
#
# The previous version of this line assumed `mamba` unconditionally and
# swallowed its own failure with `2>/dev/null || true` -- which is exactly
# why this removal silently never ran on at least one build (this dev
# machine, used to test the script, only has `micromamba` installed; `mamba`
# doesn't exist here at all). Detect whichever tool is actually present
# instead of assuming, and let a real failure stop the build (no `|| true`)
# so a broken removal is loud in the build log, not a silent no-op again.
#
# Removing these packages also pulls out ipykernel as a transitive
# dependency (confirmed via a real removal test), which would leave Voila
# with no kernel to execute notebook cells -- so reinstall it explicitly
# afterward.
set -e
if command -v mamba >/dev/null 2>&1; then
    CONDA_TOOL=mamba
elif command -v micromamba >/dev/null 2>&1; then
    CONDA_TOOL=micromamba
else
    echo "ERROR: neither mamba nor micromamba found on PATH" >&2
    exit 1
fi
echo "postBuild: using $CONDA_TOOL to remove jupyterlab/notebook/jupyter-resource-usage"
$CONDA_TOOL remove -y jupyterlab notebook jupyter-resource-usage
$CONDA_TOOL install -y -c conda-forge ipykernel

# Separately: ipywidgets' own output rendering unconditionally calls the
# legacy MathJax v2 `Hub.Queue` API whenever `window.MathJax` is truthy,
# regardless of which MathJax version actually loaded -- and voila's real
# MathJax v2.7.7 CDN script (its hardcoded default) has a load/init race
# that leaves `.Hub` undefined when typeset() fires too early, throwing
# "Cannot read properties of undefined (reading 'Queue')" and aborting
# Voila's page init entirely (this, not the jupyterlab conflict above, was
# the actual remaining cause of "Loading widget..." never resolving).
#
# None of these apps use LaTeX, so point MathJax loading at a tiny inline
# no-op stub instead: `window.MathJax.Hub.Queue` exists and does nothing.
#
# A `Voila.mathjax_url` trait override does this cleanly for the standalone
# `voila` CLI, but Binder actually runs voila as a jupyter_server extension
# (the `voila/tree/...` URL path within one running `jupyter server`, not a
# direct `voila <notebook>` invocation) -- a materially different code path
# that reads voila/utils.py's hardcoded default directly rather than any
# Voila-app trait or config file (confirmed: a voila_config.py setting
# Voila.mathjax_url did NOT take effect there, even though the equivalent
# CLI flag works fine for the standalone app). So patch the default in
# voila/utils.py itself, via Python so the install path doesn't need to be
# hardcoded. Verified via the browser console in the actual server-
# extension code path (a local `jupyter server` with voila's extension
# enabled, navigated to `/voila/render/...`, matching what Binder does):
# zero exceptions after this patch, vs. the crash above before it.
python3 - << 'PYEOF'
import voila.utils

path = voila.utils.__file__
content = open(path).read()
old = "https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js"
stub = (
    "data:text/javascript;base64,"
    "d2luZG93Lk1hdGhKYXggPSB3aW5kb3cuTWF0aEpheCB8fCB7fTsKd2luZG93Lk1hdGhKYXguSHViID0gd2luZG93Lk1hdGhKYXguSHViIHx8IHsKICBRdWV1ZTogZnVuY3Rpb24gKCkgeyByZXR1cm4geyB0aGVuOiBmdW5jdGlvbiAoKSB7fSB9OyB9LAogIENvbmZpZzogZnVuY3Rpb24gKCkge30sCn07Cg=="
)
if old in content:
    open(path, "w").write(content.replace(old, stub))
    print(f"patched mathjax default in {path}")
else:
    print(f"WARNING: mathjax CDN string not found in {path}, voila version may have changed this")
PYEOF
